{
  "name": "starter-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Classic WordPress theme starter optimized for Claude Code",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:css",
    "build:css": "sass sass/style.scss css/style.css --style=compressed --source-map --no-error-css",
    "watch": "sass sass/style.scss css/style.css --style=expanded --source-map --watch",
    "lint": "npm run lint:css && npm run lint:php",
    "lint:css": "stylelint \"sass/**/*.scss\"",
    "lint:css:fix": "stylelint \"sass/**/*.scss\" --fix",
    "lint:php": "node scripts/lint-php.mjs"
  },
  "devDependencies": {
    "sass": "^1.83.0",
    "stylelint": "^16.12.0",
    "stylelint-config-standard-scss": "^14.0.0"
  },
  "volta": {
    "node": "22.23.5"
  }
}
